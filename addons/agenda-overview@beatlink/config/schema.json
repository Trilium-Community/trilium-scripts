    "searchGroups": {
        "type": "registry",
        "label": "Search Groups",
        "category": "Review",
        "tab": "Searches",
        "itemSchema": {
            "name": {
                "type": "string",
                "label": "Name",
                "default": "New Group"
            },
            "profileId": {
                "type": "reference",
                "label": "Profile",
                "registry": "profiles",
                "default": ""
            },
            "type": {
                "type": "select",
                "label": "Source",
                "description": "By Area, By Priority and By Template build one search per value from that addon's own settings, so there is nothing to fill in below. Groups for the installed pickers are generated for you; the group is ignored when the addon isn't installed.",
                "default": "manual",
                "options": [
                    {
                        "value": "manual",
                        "label": "Manual"
                    },
                    {
                        "value": "area",
                        "label": "By Area"
                    },
                    {
                        "value": "priority",
                        "label": "By Priority"
                    },
                    {
                        "value": "template",
                        "label": "By Template"
                    }
                ]
            },
            "children": {
                "type": "registry",
                "label": "Searches",
                "default": {},
                "itemSchema": {
                    "name": {
                        "type": "string",
                        "label": "Name",
                        "default": "New Search"
                    },
                    "rule": {
                        "type": "string",
                        "label": "Search Rule",
                        "default": ""
                    },
                    "enabled": {
                        "type": "boolean",
                        "label": "Enabled",
                        "default": true
                    }
                },
                "showWhen": {
                    "type": "manual"
                }
            }
        },
        "description": "An entry is generated automatically for each installed picker (area-picker@beatlink, priority-widget@beatlink, template-picker@beatlink) and cannot be edited here - change the vocabulary in that addon's own settings."
    },
