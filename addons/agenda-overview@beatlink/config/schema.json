{
    "_categories": [
        "Review",
        "Settings"
    ],
    "startDatetimeLabel": {
        "type": "string",
        "label": "Start Datetime Label",
        "description": "The note label holding a task's start datetime. Read for the overview's Start column, the iCal feed and due notifications. agenda-task@beatlink and agenda-myday@beatlink each carry their own copy of this setting; rename it in one and rename it in the others too.",
        "category": "Settings",
        "tab": "Settings"
    },
    "dueDatetimeLabel": {
        "type": "string",
        "label": "Due Datetime Label",
        "description": "The note label holding a task's due datetime. Read for the overview's Due column and the iCal feed.",
        "category": "Settings",
        "tab": "Settings"
    },
    "recurrenceLabel": {
        "type": "string",
        "label": "Recurrence Label",
        "description": "The note label holding a task's recurrence rule. Read for the iCal feed and for grouping/filtering by recurrence frequency.",
        "category": "Settings",
        "tab": "Settings"
    },
    "overviewNoteId": {
        "type": "note",
        "label": "Overview Note",
        "description": "The single shared collection note the active profile's matching tasks are filed under. Opening it shows the active profile's tasks in the chosen collection view.",
        "category": "Review",
        "tab": "Overview"
    },
    "activeProfileId": {
        "type": "reference",
        "registry": "profiles",
        "label": "Active Profile",
        "description": "Which profile currently populates the shared Overview Note. Switchable here or from the Agenda sidebar widget.",
        "category": "Review",
        "tab": "Active Profile"
    },
    "sectionState": {
        "type": "json",
        "hidden": true,
        "label": "Section State"
    },
