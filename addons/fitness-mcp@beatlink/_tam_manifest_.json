{
    "id": "fitness-mcp@beatlink",
    "name": "Fitness MCP",
    "description": "An MCP server for the diet-manager, workout-manager and body-metrics addons, so an AI agent can read and edit your diet diary, foods and recipes, workout log and programs, and body measurements. It runs as a backend custom request handler at /custom/fitness-mcp (Streamable HTTP, stateless), finds each installed addon's database on its own, and writes through the same data model the widgets use. It needs backend scripting enabled and has no authentication, so only expose it on a network you trust.",
    "author": "BeatLink",
    "homepage": "https://github.com/Trilium-Community/trilium-scripts/tree/main/addons/fitness-mcp@beatlink",
    "license": "GPL-3.0-or-later",
    "latestVersion": "1.0.0",
    "type": "script",
    "readme": "README.md",
    "changelog": "CHANGELOG.md",
    "manifestSourceUrl": "https://trilium-community.github.io/trilium-scripts/fitness-mcp@beatlink/_tam_manifest_.json",
